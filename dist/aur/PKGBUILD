# Maintainer: nervosys <https://github.com/nervosys>
pkgname=ibt
pkgver=1.0.0
pkgrel=1
pkgdesc="Agentic-first CLI successor to dd; human-first GUI/TUI successor to Etcher, Rufus, Ventoy"
arch=('x86_64' 'aarch64')
url="https://github.com/nervosys/IronBlockTransfer"
license=('MIT' 'Apache-2.0')
depends=('gcc-libs')
makedepends=('rust' 'cargo')
optdepends=(
  'gtk3: GUI support'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/nervosys/IronBlockTransfer/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('RELEASE_SHA256_PLACEHOLDER')

prepare() {
  cd "IronBlockTransfer-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "IronBlockTransfer-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

check() {
  cd "IronBlockTransfer-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --all-features
}

package() {
  cd "IronBlockTransfer-$pkgver"
  install -Dm755 "target/release/ibt" "$pkgdir/usr/bin/ibt"

  # Shell completions
  install -Dm644 /dev/null "$pkgdir/usr/share/bash-completion/completions/ibt"
  target/release/ibt completions bash > "$pkgdir/usr/share/bash-completion/completions/ibt"

  install -Dm644 /dev/null "$pkgdir/usr/share/zsh/site-functions/_ibt"
  target/release/ibt completions zsh > "$pkgdir/usr/share/zsh/site-functions/_ibt"

  install -Dm644 /dev/null "$pkgdir/usr/share/fish/vendor_completions.d/ibt.fish"
  target/release/ibt completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/ibt.fish"

  # Man pages
  mkdir -p "$pkgdir/usr/share/man/man1"
  target/release/ibt man --output-dir "$pkgdir/usr/share/man/man1"

  # License
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
