#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	cargo build --release --all-features

override_dh_auto_install:
	install -Dm755 target/release/ibt debian/ibt/usr/bin/ibt
	# Shell completions
	mkdir -p debian/ibt/usr/share/bash-completion/completions
	target/release/ibt completions bash > debian/ibt/usr/share/bash-completion/completions/ibt
	mkdir -p debian/ibt/usr/share/zsh/vendor-completions
	target/release/ibt completions zsh > debian/ibt/usr/share/zsh/vendor-completions/_ibt
	mkdir -p debian/ibt/usr/share/fish/vendor_completions.d
	target/release/ibt completions fish > debian/ibt/usr/share/fish/vendor_completions.d/ibt.fish
	# Man pages
	mkdir -p debian/ibt/usr/share/man/man1
	target/release/ibt man --output-dir debian/ibt/usr/share/man/man1

override_dh_auto_test:
	cargo test --all-features
